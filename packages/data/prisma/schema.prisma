generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  archived
}

enum ModuleStatus {
  enabled
  disabled
  degraded
}

enum AuditActorType {
  user
  bot
  system
  integration
}

enum SanctionKind {
  ban
  mute
  restrict
  warn
  delete
  lock
}

enum CaptchaMode {
  button
  text
  math
  custom
}

enum PolicyAction {
  allow
  warn
  delete
  mute
  ban
  review
}

// --- Guardian Verification (join-request camera verification) ---

enum GuardianMode {
  off
  manual
  assisted
  auto
  strict
}

enum GuardianCaptureMode {
  photo
  video
  video_with_fallback
}

enum GuardianChallengeDifficulty {
  basic
  normal
  strict
}

enum GuardianSessionStatus {
  pending
  miniapp_opened
  capturing
  analyzing
  awaiting_retry
  resolved
  expired
  cancelled
}

enum GuardianDecision {
  auto_approve
  manual_review
  retry
  auto_decline
  technical_failure
}

// Shared status vocabulary for every pluggable AI provider (liveness, age,
// synthetic-media, provenance). `not_evaluated` = provider not configured at
// all; `unavailable` = configured but the call failed/timed out; `uncertain` =
// the provider ran but could not commit to a verdict. Never fabricate a score
// for `not_evaluated`/`unavailable`/`failed`.
enum GuardianProviderStatus {
  success
  uncertain
  unavailable
  failed
  not_evaluated
}

enum GuardianProvenanceStatus {
  c2pa_valid_ai_declared
  c2pa_valid_other
  c2pa_invalid
  c2pa_not_found
  c2pa_unavailable
}

enum GuardianStaffAction {
  approve
  decline
  retry
  delete_media
  mark_false_positive
  expel
}

enum ManagedBotStatus {
  pending
  active
  suspended
  revoked
  failed
}

enum ManagedBotTemplate {
  community
  creator
  support
  business
  custom
}

enum PlatformRole {
  platform_owner
  promo_admin
  bot_factory_admin
  support_admin
  auditor
}

enum EntitlementKind {
  managed_bot_slot
  pro_trial
  agency_pack
}

enum EntitlementSource {
  promo
  payment
  manual
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bots         ManagedBot[]
  chats        Chat[]
  users        AppUser[]
  roles        Role[]
  flags        FeatureFlag[]
  modules      ModuleState[]
  auditLogs    AuditLog[]
  security     SecurityAlert[]
  settings     ChatSetting[]
  cases        ModerationCase[]
  memberships  Membership[]
  topics       Topic[]
  roleBindings RoleBinding[]
  promoCodes   PromoCode[]
  entitlements Entitlement[]

  @@map("tenants")
}

model ManagedBot {
  id                          String             @id @default(cuid())
  tenantId                    String
  telegramBotId               BigInt?            @unique
  username                    String             @unique
  displayName                 String
  ownerTelegramId             BigInt?
  template                    ManagedBotTemplate @default(community)
  status                      ManagedBotStatus   @default(active)
  encryptedToken              String?
  tokenFingerprint            String?
  tokenLastRotatedAt          DateTime?
  webhookSecretHash           String?
  plan                        String             @default("free")
  entitlementId               String?
  createdViaPromoRedemptionId String?
  lastActivatedAt             DateTime?
  lastError                   String?
  expiryWarnedAt              DateTime?
  isPrimary                   Boolean            @default(false)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ownerTelegramId])
  @@index([status])
  @@map("managed_bots")
}

model PlatformRoleAssignment {
  id                  String       @id @default(cuid())
  telegramUserId      BigInt
  role                PlatformRole
  grantedByTelegramId BigInt?
  revokedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([telegramUserId])
  @@index([role])
  @@map("platform_role_assignments")
}

model PlatformUserBan {
  id                  String    @id @default(cuid())
  telegramUserId      BigInt    @unique
  reason              String
  bannedByTelegramId  BigInt
  bannedAt            DateTime  @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([revokedAt])
  @@index([expiresAt])
  @@map("platform_user_bans")
}

model PromoCode {
  id                  String             @id @default(cuid())
  tenantId            String?
  codeHash            String             @unique
  codePrefix          String
  kind                EntitlementKind
  template            ManagedBotTemplate @default(community)
  quantity            Int                @default(1)
  maxUses             Int                @default(1)
  usedCount           Int                @default(0)
  expiresAt           DateTime?
  revokedAt           DateTime?
  note                String?
  createdByTelegramId BigInt
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions PromoRedemption[]

  @@index([tenantId])
  @@index([createdByTelegramId])
  @@map("promo_codes")
}

model PromoRedemption {
  id                   String   @id @default(cuid())
  promoCodeId          String
  redeemedByTelegramId BigInt
  entitlementId        String
  redeemedAt           DateTime @default(now())

  promoCode   PromoCode   @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, redeemedByTelegramId])
  @@index([redeemedByTelegramId])
  @@map("promo_redemptions")
}

model Entitlement {
  id                  String             @id @default(cuid())
  tenantId            String?
  ownerTelegramId     BigInt
  kind                EntitlementKind
  template            ManagedBotTemplate @default(community)
  quantity            Int                @default(1)
  usedQuantity        Int                @default(0)
  source              EntitlementSource
  sourceRef           String?
  expiresAt           DateTime?
  revokedAt           DateTime?
  createdByTelegramId BigInt?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions PromoRedemption[]

  @@index([tenantId])
  @@index([ownerTelegramId])
  @@index([kind])
  @@map("entitlements")
}

model AppUser {
  id             String   @id @default(cuid())
  tenantId       String?
  telegramUserId BigInt   @unique
  username       String?
  languageCode   String?
  displayName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  memberships Membership[]
  preferences UserPreference?
  bindings    RoleBinding[]
  warnings    Warning[]
  sanctions   Sanction[]
  appeals     Appeal[]

  @@index([tenantId])
  @@map("users")
}

model Chat {
  id             String   @id @default(cuid())
  tenantId       String
  telegramChatId BigInt
  type           String
  title          String?
  username       String?
  isForum        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  topics      Topic[]
  settings    ChatSetting[]
  modules     ModuleState[]
  cases       ModerationCase[]

  @@unique([tenantId, telegramChatId])
  @@index([tenantId])
  @@map("chats")
}

model Membership {
  id        String    @id @default(cuid())
  tenantId  String
  chatId    String
  userId    String
  role      String    @default("member")
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat   Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, chatId])
  @@index([tenantId, userId])
  @@map("memberships")
}

model Topic {
  id              String   @id @default(cuid())
  tenantId        String
  chatId          String
  telegramTopicId Int
  title           String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, telegramTopicId])
  @@index([tenantId])
  @@map("topics")
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  locale        String   @default("es")
  timezone      String   @default("Europe/Madrid")
  dateFormat    String   @default("dd/MM/yyyy")
  accessibility Json?
  notifications Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings RoleBinding[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  @@map("permissions")
}

model RoleBinding {
  id        String    @id @default(cuid())
  tenantId  String
  roleId    String
  userId    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("role_bindings")
}

model NativeAdminSnapshot {
  id         String   @id @default(cuid())
  tenantId   String
  chatId     String
  userId     String
  payload    Json
  capturedAt DateTime @default(now())

  @@index([tenantId, chatId])
  @@map("native_admin_snapshots")
}

model Approval {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String
  status    String   @default("pending")
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@map("approvals")
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("feature_flags")
}

model ModuleState {
  id        String       @id @default(cuid())
  tenantId  String
  chatId    String?
  moduleKey String
  status    ModuleStatus @default(disabled)
  version   String?
  config    Json?
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat   Chat?  @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chatId, moduleKey])
  @@index([tenantId, moduleKey])
  @@map("module_states")
}

model UpdateInbox {
  id          String    @id @default(cuid())
  tenantId    String?
  botKey      String
  updateId    BigInt
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([botKey, updateId])
  @@index([tenantId, botKey])
  // Por donde barre el job de retencion, cada minuto. Sin este indice la
  // consulta "que hay mas viejo que X" es un escaneo completo de la tabla por
  // la que entra cada update de Telegram.
  @@index([createdAt])
  @@map("update_inbox")
}

model CallbackInbox {
  id          String    @id @default(cuid())
  tenantId    String?
  callbackId  String    @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@map("callback_inbox")
}

model IdempotencyKey {
  id        String    @id @default(cuid())
  tenantId  String?
  namespace String
  key       String
  payload   Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([namespace, key])
  @@index([tenantId])
  @@map("idempotency_keys")
}

model JobOutbox {
  id        String    @id @default(cuid())
  tenantId  String?
  topic     String
  payload   Json
  state     String    @default("pending")
  runAfter  DateTime?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, state])
  @@map("job_outbox")
}

model AuditLog {
  id           String         @id @default(cuid())
  tenantId     String?
  actorType    AuditActorType @default(system)
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  payload      Json?
  createdAt    DateTime       @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  // Por donde barre el job de retencion. El indice de arriba NO sirve: empieza
  // por tenantId, y la barrida pregunta "que hay mas viejo que X" sin filtrar
  // por tenant, asi que se lo saltaria y escanearia la tabla entera.
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityAlert {
  id             String    @id @default(cuid())
  tenantId       String?
  severity       String    @default("info")
  code           String
  message        String
  payload        Json?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, severity])
  @@map("security_alerts")
}

model SecretRef {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  provider  String
  reference String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("secrets_refs")
}

model PrivacyRequest {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  kind      String
  status    String   @default("open")
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@map("privacy_requests")
}

model Backup {
  id          String    @id @default(cuid())
  tenantId    String?
  kind        String
  status      String    @default("pending")
  storageRef  String?
  checksum    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([tenantId, status])
  @@map("backups")
}

model ChatSetting {
  id        String   @id @default(cuid())
  tenantId  String
  chatId    String?
  key       String
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat   Chat?  @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chatId, key])
  @@map("chat_settings")
}

model ModerationCase {
  id            String   @id @default(cuid())
  tenantId      String
  chatId        String?
  caseNumber    Int
  subjectUserId String?
  status        String   @default("open")
  reason        String?
  payload       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat   Chat?  @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([tenantId, caseNumber])
  @@index([tenantId, chatId])
  @@map("moderation_cases")
}

model Sanction {
  id        String       @id @default(cuid())
  tenantId  String
  caseId    String?
  userId    String
  kind      SanctionKind
  status    String       @default("active")
  reason    String?
  startsAt  DateTime     @default(now())
  endsAt    DateTime?
  payload   Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@map("sanctions")
}

model Warning {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  caseId    String?
  reason    String?
  weight    Int       @default(1)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  expiredAt DateTime?

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt, expiredAt])
  @@map("warnings")
}

model Report {
  id                String   @id @default(cuid())
  tenantId          String
  chatId            String?
  reporterUserId    String?
  subjectTelegramId BigInt
  reason            String?
  status            String   @default("open")
  createdAt         DateTime @default(now())

  @@index([tenantId, status])
  @@map("reports")
}

model Evidence {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  type       String
  storageRef String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([tenantId, caseId])
  @@map("evidence")
}

model Appeal {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  userId     String
  status     String   @default("open")
  message    String
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, caseId, status])
  @@map("appeals")
}

model SpamProfile {
  id        String   @id @default(cuid())
  tenantId  String
  chatId    String?
  name      String
  threshold Int      @default(0)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chatId, name])
  @@map("spam_profiles")
}

model AntifloodConfig {
  id              String   @id @default(cuid())
  tenantId        String
  chatId          String   @unique
  enabled         Boolean  @default(false)
  windowSeconds   Int      @default(10)
  messageLimit    Int      @default(5)
  action          String   @default("mute")
  muteSeconds     Int      @default(300)
  cooldownSeconds Int      @default(30)
  exempt          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("antiflood_configs")
}

model AntifloodEvent {
  id             String   @id @default(cuid())
  tenantId       String
  chatId         String
  telegramUserId BigInt
  messageCount   Int
  windowSeconds  Int
  action         String
  createdAt      DateTime @default(now())

  @@index([tenantId, chatId, createdAt])
  @@index([tenantId, telegramUserId])
  @@map("antiflood_events")
}

model AntiraidConfig {
  id                String    @id @default(cuid())
  tenantId          String
  chatId            String    @unique
  enabled           Boolean   @default(false)
  windowSeconds     Int       @default(30)
  joinLimit         Int       @default(5)
  mode              String    @default("observe")
  newAccountAgeDays Int       @default(0)
  underAttackUntil  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@map("antiraid_configs")
}

model AntiraidEvent {
  id            String   @id @default(cuid())
  tenantId      String
  chatId        String
  joinCount     Int
  windowSeconds Int
  mode          String
  createdAt     DateTime @default(now())

  @@index([tenantId, chatId, createdAt])
  @@map("antiraid_events")
}

model Note {
  id        String   @id @default(cuid())
  tenantId  String
  chatId    String
  name      String
  content   String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chatId, name])
  @@index([tenantId, chatId])
  @@map("notes")
}

model StaffNote {
  id               String   @id @default(cuid())
  tenantId         String
  chatId           String
  authorTelegramId BigInt?
  authorName       String?
  text             String
  createdAt        DateTime @default(now())

  @@index([tenantId, chatId])
  @@map("staff_notes")
}

model EconomyWallet {
  id             String   @id @default(cuid())
  tenantId       String
  chatId         String
  userTelegramId BigInt
  balance        Int      @default(0)
  lastEarnedMs   BigInt   @default(0)
  /// Juego justo (commit-reveal), igual que en ChipWallet: `serverSeed` es
  /// SECRETO hasta que se rota, `serverSeedHash` es el compromiso publico que se
  /// enseña antes de apostar, y `nonce` sube en cada apuesta para que todo
  /// resultado se pueda recomputar desde (serverSeed, clientSeed, nonce).
  ///
  /// Los tres textos son opcionales porque la tabla ya tenia filas cuando se
  /// añadieron: una cartera que solo se uso para hablar no tiene semillas hasta
  /// que su dueño apuesta por primera vez. `ensureBettingWallet` las siembra
  /// entonces. Un default fijo aqui seria peor que nulo — todo el mundo
  /// compartiendo semilla es exactamente lo que el sistema existe para evitar.
  serverSeed     String?
  serverSeedHash String?
  clientSeed     String?
  nonce          Int      @default(0)
  /// Saldo a salvo de robos: la "caja fuerte". Cuenta dentro de `balance` —no
  /// es un segundo monedero—, y lo unico que hace es marcar cuanto de ese saldo
  /// no puede tocar `/robar`. Se guarda aparte precisamente para que un robo no
  /// tenga que adivinar que parte era intocable.
  protectedBalance Int    @default(0)
  /// Cuanto cabe en esa caja fuerte. Sin un tope, `protectedBalance` no seria
  /// una caja fuerte sino un interruptor de inmunidad: bastaria con guardarlo
  /// todo para no poder ser robado nunca, y el robo dejaria de existir en
  /// cuanto la gente se diera cuenta.
  ///
  /// El default 0 significa "el basico del grupo", no "no cabe nada": el tope
  /// real lo calcula quien lee, sumando lo que se haya ampliado en la tienda.
  /// Guardado asi, las filas que ya existian no necesitan tocarse.
  vaultLimit     Int      @default(0)
  /// Saldo sin fondo: la cartera paga siempre y el numero NO se mueve.
  ///
  /// No es "un saldo muy alto". `balance` es un `integer`, asi que un saldo muy
  /// alto tiene techo (2.147.483.647) y ademas se gasta: la cuenta baja hasta
  /// que un dia no llega. Con esta bandera el saldo se congela —ni se cobra ni
  /// se abona— y lo que cuenta el movimiento es el libro mayor, que sigue
  /// anotandolo todo. Por eso el numero que enseña `/saldo` deja de ser un
  /// saldo y pasa a ser un adorno; la verdad esta en `economy_ledger`.
  ///
  /// Congelar el abono tambien es lo que quita el desbordamiento de en medio:
  /// una cartera que nunca suma no puede reventar con "integer out of range".
  ///
  /// Es un privilegio del propietario y va cartera a cartera (tenant + chat +
  /// persona), nunca por usuario global: la economia vive por grupo y una
  /// bandera global regalaria el privilegio en grupos donde nadie lo pidio.
  unlimited      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, chatId, userTelegramId])
  @@map("economy_wallets")
}

/// Libro mayor de la moneda del grupo: una fila por cada movimiento de saldo.
///
/// Existe por dos razones distintas y las dos importan. La primera es
/// idempotencia: el unique de abajo hace que reintentar una concesion no la
/// pague dos veces. La segunda es que un saldo a secas no puede responder a
/// "quien me ha robado", que es LA pregunta que va a llegar el primer dia que
/// alguien pierda monedas mientras no miraba.
///
/// `refId` es lo que distingue un movimiento de otro dentro del mismo `reason`:
/// el dia UTC para la ganancia diaria, un uuid para donaciones y robos, que son
/// irrepetibles por definicion. Ojo al usarlo: en Postgres dos NULL no colisionan,
/// asi que un `refId` nulo desactiva la proteccion en vez de reforzarla.
model EconomyLedger {
  id             String   @id @default(cuid())
  tenantId       String
  chatId         String
  telegramUserId BigInt
  delta          Int
  reason         String
  refId          String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, chatId, telegramUserId, reason, refId])
  @@index([tenantId, chatId, telegramUserId])
  @@map("economy_ledger")
}

/// Lo que cada persona tiene comprado en la tienda del grupo.
///
/// Una fila por (persona, objeto) y no una por compra: la segunda navaja suma
/// usos y el segundo escudo alarga el que ya habia. Con una fila por compra
/// habria que decidir cual se gasta primero en cada golpe, y esa es una
/// pregunta que no le interesa a nadie y que se puede responder mal.
///
/// `uses` y `expiresAt` conviven porque hay dos formas de tener un objeto: los
/// consumibles se gastan (usos, sin fecha) y los temporales caducan (fecha,
/// usos a 1). Cual es cual lo sabe el catalogo de @superbot/module-games, no
/// esta tabla: los precios y las duraciones se retocan, y una copia aqui seria
/// una copia que se queda vieja.
model UserItem {
  id             String    @id @default(cuid())
  tenantId       String
  chatId         String
  userTelegramId BigInt
  itemId         String
  uses           Int       @default(1)
  expiresAt      DateTime?
  /// El texto de los objetos que lo piden: el mote, el nombre nuevo de la
  /// moneda. Nulo en todo lo demas.
  payload        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, chatId, userTelegramId, itemId])
  @@index([tenantId, chatId, userTelegramId])
  @@map("user_items")
}

/// Cada compra, para poder responder a "quien le ha comprado eso a quien".
///
/// El libro mayor de la economia ya anota el cobro, pero solo sabe que salieron
/// 5.000 monedas por "shop-buy". Cuando alguien pregunte quien le ha comprado
/// la mordaza —y va a preguntarlo el primer dia— la respuesta esta aqui.
///
/// De aqui salen ademas dos numeros que no se guardan en ningun otro sitio: lo
/// que cuesta la fianza (el doble de la mordaza que te comiste) y si a esa
/// persona le compraron otra hace demasiado poco. Los dos se derivan de estas
/// filas a proposito, igual que las esperas del robo salen del libro mayor: un
/// contador aparte es un sitio mas donde el numero puede contradecir a los
/// hechos.
model ShopPurchase {
  id               String   @id @default(cuid())
  tenantId         String
  chatId           String
  userTelegramId   BigInt
  itemId           String
  price            Int
  /// A quien iba dirigido, en los que se disparan contra alguien. Nulo en el
  /// resto.
  targetTelegramId BigInt?
  createdAt        DateTime @default(now())

  @@index([tenantId, chatId, createdAt])
  @@index([tenantId, chatId, targetTelegramId, createdAt])
  @@map("shop_purchases")
}

