  tensionScore    Float?
  createdAt       DateTime @default(now())

  @@index([tenantId, chatId, createdAt])
  @@index([tenantId, chatId, kind, createdAt])
  @@index([tenantId, chatId, messageId])
  // Los tres de arriba empiezan por tenantId: ninguno sirve para la barrida
  // por fecha del job de retencion.
  @@index([createdAt])
  @@map("chat_activity_events")
}

// ─── Wave 2 wiring (guardian-verification branch): security detectors, ECA
// engine, and hidden games. Each model backs one repository under
// packages/data/src/; see that file's docstring for what it's for. No
// relation fields to Tenant/Chat are declared (matching ChatActivityEvent
// above) so these can be appended without touching either model's
// back-relation arrays.

model AdminDecision {
  id         String   @id @default(cuid())
  tenantId   String
  chatId     String
  adminId    BigInt
  action     String
  ruleId     String?
  occurredAt DateTime @default(now())

  @@index([tenantId, chatId, occurredAt])
  @@index([tenantId, adminId])
  @@map("admin_decisions")
}

model KnownAdmin {
  id        String   @id @default(cuid())
  tenantId  String
  chatId    String
  adminId   BigInt
  createdAt DateTime @default(now())

  @@unique([tenantId, chatId, adminId])
  @@index([tenantId, chatId])
  @@map("known_admins")
}

/// An administrator THIS BOT appointed, via /admin.
///
/// The linchpin of the whole appointed-admin guard, because of a hard Telegram
/// rule: a bot may only demote administrators it promoted itself. Without this
/// row the bot cannot tell "someone I can revoke" from "someone I can only
/// watch", and the guard would trip with no way to act. Anyone promoted by hand
/// in Telegram is therefore permanently out of reach — /admin is not a
/// convenience, it is the only door that leaves the trapdoor open.
model BotGrantedAdmin {
  id             String @id @default(cuid())
  tenantId       String
  /// Internal chat id, like every other per-chat table here.
  chatId         String
  /// Raw Telegram ids too: enforcement talks to the Bot API, which knows
  /// nothing about internal cuids, and must work without a second lookup.
  telegramChatId BigInt
  telegramUserId BigInt
  username       String?
  displayName    String?
  customTitle    String?

  /// Who ran /admin. An appointment is an act by a person, and when the guard
  /// later revokes someone, the first question is always who vouched for them.
  grantedByTelegramId BigInt
  grantedAt           DateTime @default(now())

  /// active | revoked. Revoked rows are KEPT: the history of who was trusted
  /// and why it ended is the point, and a re-appointment must be visible as a
  /// second event rather than silently overwriting the first.
  status        String    @default("active")
  revokedAt     DateTime?
  /// Machine-readable cause, e.g. "guard:ban_burst" or "manual".
  revokedReason String?

  /// Set when this person was already an admin before the bot got involved and
  /// was re-appointed through it to bring them under the guard. Distinguishes
  /// "the bot trusted them" from "the bot merely took over an existing badge".
  adoptedExisting Boolean @default(false)

  @@unique([tenantId, chatId, telegramUserId])
  @@index([tenantId, chatId, status])
  @@index([telegramChatId, status])
  @@map("bot_granted_admins")
}

/// A newcomer who owes the group an introduction.
///
/// A row exists only while the clock is running. It is deleted the moment they
/// introduce themselves or are removed, so the table stays the size of "people
/// currently on the clock" rather than growing with every join the group has
/// ever had.
model IntroductionPending {
  id             String   @id @default(cuid())
  tenantId       String
  chatId         String
  telegramChatId BigInt
  telegramUserId BigInt
  username       String?
  joinedAt       DateTime @default(now())
  /// When they stop being welcome. Stored rather than computed from joinedAt so
  /// changing the group's deadline later cannot retroactively expel someone who
  /// was already inside the old window.
  dueAt          DateTime
  /// Avisos de la escalada ya puestos DESPUÉS de la ficha (el 1.º va con la
  /// ficha misma y no cuenta aquí). Con `reportedAt` da el momento del
  /// siguiente: reportedAt + (reminders+1) × cadencia.
  reminders      Int      @default(0)
  /// When the STAFF card for this person was posted. Null means the deadline is
  /// still running or has just passed; set means a human has the case — and,
  /// desde la escalada, tambien el reloj desde el que se cuentan los avisos
  /// periodicos. Without this the sweep re-posts the same card every minute —
  /// the row cannot simply be deleted at report time, or the buttons would
  /// have nothing left to act on.
  reportedAt     DateTime?
  /// Dónde quedó publicada la ficha de STAFF, para que la escalada pueda
  /// editarla al expulsar. Null en filas de antes de la migración o si el
  /// envío no devolvió message_id: la expulsión entonces no edita nada — la
  /// ficha se queda como estaba y sus botones responden "ya no está abierto".
  staffChatId    BigInt?
  staffThreadId  Int?
  staffMessageId Int?

  @@unique([tenantId, chatId, telegramUserId])
  @@index([dueAt])
  @@map("introduction_pending")
}

