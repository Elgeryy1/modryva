/// Fotos rescatadas de los canales de STAFF y guardadas aparte, para que el bot
/// consultor pueda volver a enseñarlas.
///
/// Existe porque `verification_media` no sirve para esto: su retención (72 h por
/// defecto) es una promesa de privacidad que se le hace a cada persona en la
/// pantalla de consentimiento, y el barrido la cumple borrando el fichero. Sacar
/// una copia a otra tabla NO es un detalle de implementación — es una decisión
/// deliberada de conservar lo que allí se borra, y por eso vive en su propio
/// sitio, con su propia fecha y su propio origen, en vez de mezclarse con las
/// filas que la retención gobierna.
///
/// `capturedAt` es la fecha del mensaje original, no la del archivado: el
/// archivador puede pasar meses después y una ficha fechada el día del rescate
/// no dice nada de cuándo entró esa persona.
model ArchivedMedia {
  id       String @id @default(cuid())
  tenantId String
  /// A quién pertenece, leído del ID que la ficha de STAFF lleva en el texto.
  telegramUserId BigInt
  /// `verification` (la foto que pidió Guardian) o `introduction` (la que la
  /// persona publicó en el grupo al presentarse). Se guardan juntas porque la
  /// pregunta que se hace desde el grupo es "enséñame sus fotos", no
  /// "enséñame sus fotos de tal flujo".
  kind String
  /// Clave en el mismo object storage que usa Guardian, bajo otro prefijo.
  objectStorageKey String
  /// Deduplica: la misma foto reenviada a dos canales se archiva una vez.
  sha256    String
  mimeType  String?
  sizeBytes Int?
  /// De qué mensaje salió. Es lo que hace que el archivador se pueda repetir
  /// sin duplicar nada, y lo que permite volver al original.
  sourceChatId    BigInt?
  sourceMessageId Int?
  /// La sesión de Guardian, cuando se pudo atar a una.
  sessionId String?
  /// Fecha del mensaje original.
  capturedAt DateTime
  archivedAt DateTime @default(now())

  @@unique([sourceChatId, sourceMessageId])
  @@index([telegramUserId, capturedAt])
  @@index([sha256])
  @@index([sessionId])
  @@map("archived_media")
}

/// Registro completo de mensajes.
///
/// Decision explicita del propietario (2026-08-09): Modryva guarda TODO lo que
/// ve —texto, fotos, videos y audios, en todos los grupos— y sin caducidad.
/// Va en su propia tabla y NO dentro de `chat_activity_events` por dos motivos
/// que no son de estilo: aquella caduca a los 90 dias (`data.retention_cleanup`)
/// y alimenta heuristicas de moderacion que cuentan filas. Meter aqui el
/// historico entero habria roto lo primero y falseado lo segundo.
///
/// A diferencia del resto del esquema, aqui NO hay job de retencion. Si algun
/// dia lo hay, este es el sitio donde mirarlo primero.
///
/// El contenido de los mensajes es dato personal de terceros: quien lo
/// consulta lo hace desde el bot consultor, que vive en un solo grupo privado.
model MessageLog {
  id             String @id @default(cuid())
  tenantId       String
  /// Cuid del chat. Nulo cuando el mensaje llego de un chat que aun no estaba
  /// dado de alta: se prefiere guardar el mensaje sin ese enlace a perderlo.
  chatId         String?
  telegramChatId BigInt
  telegramUserId BigInt
  messageId      Int
  /// Tema del foro, cuando el grupo los usa.
  threadId       Int?
  username    String?
  displayName String?
  /// `text` o el tipo de adjunto (photo, video, voice, audio, document...).
  kind String
  /// Lo que escribio la persona: el texto, o el pie si venia con adjunto.
  text String?
  /// Que respondia, para poder reconstruir una conversacion.
  replyToMessageId Int?
  replyToUserId    BigInt?
  /// El file_id de Telegram. Sirve para volver a pedir el fichero, pero SOLO
  /// con el token que lo genero: un file_id no vale entre bots distintos.
  mediaFileId    String?
  mediaUniqueId  String?
  mediaMimeType  String?
  mediaSizeBytes Int?
  /// Clave en el object storage una vez bajados los bytes. Nulo mientras esta
  /// pendiente: la pareja (mediaFileId no nulo, objectStorageKey nulo) ES la
  /// cola de trabajo del job que los descarga. Se hizo asi en vez de encolar en
  /// `job_outbox` porque esa tabla no la drena nadie hoy.
  objectStorageKey String?
  /// Intentos de descarga gastados. Un 429 no da el fichero por perdido a la
  /// primera; pasado el tope, la fila se queda con el file_id y sin bytes.
  mediaAttempts Int     @default(0)
  mediaError    String?
  /// Cuando se edito, si se edito. El texto guardado es el ultimo visto.
  editedAt DateTime?
  sentAt   DateTime
  createdAt DateTime @default(now())

  /// Un mensaje es unico por chat. Reprocesar un update repetido no duplica.
  @@unique([telegramChatId, messageId])
  /// La consulta de `/mensajes` en el consultor.
  @@index([telegramUserId, sentAt])
  @@index([telegramChatId, sentAt])
  /// La cola del job de descarga.
  @@index([objectStorageKey, mediaFileId])
  @@map("message_log")
}

/// La mascota de una persona en un grupo.
///
/// Misma clave que la cartera —`(tenant, chat, persona)`— y por el mismo
/// motivo: la economia de cada grupo es la suya, asi que un bicho que comiera
/// de dos carteras obligaria a decidir de cual, y esa pregunta no tiene
/// respuesta buena.
///
/// **Una por persona y grupo, de momento.** El plan contempla un corral con
/// varias en reposo, pero eso llega con el mercado y la cria: hasta entonces no
/// hay forma de tener una segunda, y un unique es mas barato de garantizar que
/// un indice parcial "solo una activa" que el drift-check no sabria leer.
///
/// **No hay tabla de eventos de mascota, y es deliberado.** Cuatro raciones al
/// dia por bicho serian 1,4 millones de filas al año con mil mascotas. Lo que
/// hay que auditar —cada moneda que entra y sale— ya lo anota `economy_ledger`,
/// que tiene su propia politica. Esta fila se actualiza; no se acumula. Con eso
/// mil mascotas ocupan unos 200 KB y no crecen con el tiempo.
model Pet {
  id             String   @id @default(cuid())
  tenantId       String
  chatId         String
  userTelegramId BigInt

  /// Id del catalogo de @superbot/module-games. Texto y no enum: el catalogo
  /// crece por tandas y una migracion por cada especie nueva convertiria "una
  /// entrada de constantes" en "una entrada y un despliegue de base de datos".
  especie String
  /// Los rasgos con los que nacio. No cambian nunca: son su caracter.
  rasgos  String[]
  /// El nombre que le puso su dueño, si le puso alguno.
  nombre  String?

  hambre Int @default(100)
  animo  Int @default(100)
  nivel  Int @default(1)
  xp     Int @default(0)

  /// Cuando se le aplico por ultima vez el paso del tiempo. El decay no se
  /// guarda tick a tick: se calcula al mirarla, restando desde aqui. Asi un
  /// worker parado media hora no deja a nadie con el bicho congelado.
  vistaEn DateTime

  /// Raciones servidas dentro del dia que dice `racionesDia` (fecha UTC en
  /// texto). Dos campos y no uno porque el contador sin su dia no se puede
  /// distinguir de uno viejo: al cambiar el dia se reinicia solo.
  racionesHoy Int     @default(0)
  racionesDia String?

  /// El ultimo dia UTC (en texto) cuya XP ya se cobro.
  ///
  /// Sin esto la XP se repartia en CADA revision del tick —una cada quince
  /// minutos— en vez de una vez al dia: 96 veces mas rapido de lo diseñado. El
  /// 2026-08-28 hubo mascotas con 110 XP y nivel 3 a las tres horas de nacer,
  /// cuando les tocaba 0. El pago del rendimiento nunca lo sufrio porque a el
  /// ya lo guardaba el `refId` del libro mayor; la XP se quedo fuera de esa
  /// guarda, y esta columna es su equivalente.
  ///
  /// `null` significa "aun no se le ha cerrado ningun dia", que es lo correcto
  /// para una mascota recien nacida: el primer cierre le toca.
  xpDia String?

  /// Lo mejor que estuvo la barra de hambre dentro del dia que dice
  /// `hambreMaxDia`, y es lo que mira el cierre para decidir si el dia conto.
  ///
  /// El cierre corre en el primer barrido pasada la medianoche UTC —las dos de
  /// la madrugada en España—, asi que preguntar por el hambre de ESE instante
  /// no premiaba haber cuidado a la mascota: premiaba el horario. Quien le
  /// daba de comer toda la tarde llegaba a las dos con la barra ya baja y se
  /// quedaba sin XP. Con el maximo del dia, cuidar suma cuando se cuida.
  ///
  /// Dos campos y no uno, igual que `racionesHoy`: un maximo sin su dia no se
  /// distingue de uno viejo, y con el dia al lado se reinicia solo.
  hambreMax    Int     @default(0)
  hambreMaxDia String?

  /// El ultimo dia UTC en que se jugo con ella.
  ///
  /// Jugar es GRATIS y sube el animo, asi que el limite no puede ser el dinero:
  /// tiene que ser el reloj, o subirlo seria pulsar un boton en bucle. Va en su
  /// propia columna y no reutiliza `xpDia` porque son dos cosas distintas —una
  /// la decide el worker y otra la persona— y compartir la marca haria que
  /// cerrar el dia impidiera jugar.
  ///
  /// Antes de que esto existiera el animo SOLO bajaba: 1 punto por hora, sin
  /// una sola forma de subirlo. A los cuatro dias toda mascota quedaba triste
  /// para siempre y rindiendo el minimo, sin nada que su dueño pudiera hacer.
  animoDia String?

  /// Juguetes usados dentro del dia que dice `juguetesDia`.
  ///
  /// Dos campos y no uno, por lo mismo que `racionesHoy`: un contador sin su
  /// dia no se distingue de uno viejo, y con el dia al lado se reinicia solo.
  ///
  /// Separado de `animoDia` porque son dos limites distintos — uno es "jugar
  /// gratis, una vez" y otro "comprar juguetes, tres veces"— y compartir la
  /// marca haria que jugar gratis gastara una compra.
  juguetesHoy Int     @default(0)
  juguetesDia String?

  /// Dias seguidos cerrando el dia con el bicho bien cuidado.
  ///
  /// Se decide comparando el dia que se cierra con `xpDia`, no sumando uno a
  /// ciegas: si el worker se cae un dia entero, un contador a secas daria por
  /// seguidos dos dias que no lo son. Un hueco se ve y corta la racha, que es
  /// justo lo que tiene que hacer para significar algo.
  ///
  /// Ademas es lo que enciende `rentaAcumulada`, que llevaba escrita en el
  /// motor desde el principio esperando un `diaDeLaRacha` que nadie le pasaba.
  racha Int @default(0)

  /// A quien protege ademas de a su dueño, si su especie sabe hacerlo.
  ///
  /// Lo pone `/proteger @alguien` y es del efecto `protegeAOtro`. Nulo por
  /// defecto a proposito: elegir a dedo a quien cubre el bicho de otro seria
  /// decidir por esa persona.
  protegeA BigInt?

  /// Lo que le robaron y todavia no ha vuelto.
  ///
  /// El efecto `recuperaRobado` promete que lo robado vuelve poco a poco, y
  /// eso es imposible sin recordar cuanto. Sube al sufrir un robo y baja un
  /// poco cada dia en el barrido del worker, hasta cero.
  robadoPendiente Int @default(0)

  /// Juego justo, igual que en `economy_wallets`: `serverSeed` es SECRETO hasta
  /// que se revela al eclosionar, `serverSeedHash` es el compromiso publico que
  /// se enseña al comprar el huevo, y `nonce` sube en cada huevo para que todo
  /// resultado se pueda recomputar desde (serverSeed, clientSeed, nonce).
  serverSeed     String?
  serverSeedHash String?
  clientSeed     String?
  nonce          Int     @default(0)
  /// Huevos de familia seguidos sin sacar una rara. Publico a proposito: es la
  /// unica forma de contestar a "este bot me odia" con algo comprobable.
  huevosSinRara  Int     @default(0)

  /// Marca del bicho dado a mano por el creador. Se ve en el corral, y esa es
  /// justo la razon de que exista: si el regalo fuera invisible, cualquier
  /// legendaria del corral podria serlo y todas perderian su valor a la vez.
  regalada Boolean @default(false)

  /// Cuando se le declaro una enfermedad grave. `null` = sana.
  ///
  /// Un solo campo dice las dos cosas —si esta enferma y desde cuando— y asi no
  /// pueden contradecirse, que es lo que pasaria con un booleano y una fecha
  /// aparte.
  ///
  /// Esto **no lo decide el azar ni el hambre**: lo declara el propietario a
  /// mano, con motivo. La propiedad de que a hambre cero se duerme y no se
  /// muere sigue en pie: el abandono no mata, y este mecanismo no es abandono.
  enfermaDesde  DateTime?
  /// El motivo que escribio quien la declaro. Obligatorio, igual que en el
  /// resto de mandos del creador: dentro de seis meses tu tampoco te acordaras.
  enfermaMotivo String?
  /// Lo que se anuncio que costaba la operacion, congelado al diagnosticar.
  ///
  /// Guardado y no recalculado al pagar: si el saldo se mueve a mitad de plazo,
  /// la factura que se dijo en publico no puede moverse con el. Se pacto un
  /// numero y ese es el numero.
  curaCoste     Int?
  /// Con cuanto se queda su dueño despues de pagar.
  ///
  /// La factura no es una cantidad suelta sino un **suelo**: la operacion deja
  /// la cartera exactamente aqui. Guardarlo permite que el cobro sea exacto
  /// aunque el saldo se haya movido, y que dos enfermedades distintas dejen
  /// suelos distintos sin desplegar.
  curaResto     Int?
  /// Cuando se acaba el plazo. Guardado, por lo mismo que el coste.
  curaVence     DateTime?
  /// Cuantos recordatorios se han mandado ya.
  ///
  /// Es la marca que impide repetirlos, y va aqui por la misma razon que
  /// `xpDia`: el barrido mira cada mascota **cada quince minutos**, asi que un
  /// aviso sin marca propia saldria 96 veces al dia. Es exactamente el fallo
  /// que tuvo la XP el 2026-08-28, evitado esta vez antes de verlo en
  /// produccion.
  curaAvisos    Int       @default(0)
  /// Cuando fallecio. `null` = viva.
  ///
  /// Se **marca**, no se borra la fila. Cuatro motivos: un `DELETE` no se
  /// revierte y esto si; la muerte tiene que verse en la ficha, porque una fila
  /// que desaparece deja un "no tienes bicho" y un huevo nuevo en diez
  /// segundos; el corral puede enseñar la lapida; y la fila ocupa el unique de
  /// (grupo, persona), que es lo que sostiene el duelo.
  fallecidaEn   DateTime?

  nacidaEn  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chatId, userTelegramId])
  /// El corral: todas las del grupo, ordenadas por nivel.
  @@index([tenantId, chatId, nivel])
  /// La cola del tick: a quien le toca que le pase el tiempo.
  @@index([vistaEn])
  /// Quien protege a una persona. Se pregunta en CADA robo, asi que sin indice
  /// seria un escaneo de la tabla entera por golpe.
  @@index([tenantId, chatId, protegeA])
  @@map("pets")
}

/// Estado de una solicitud en la cola bot -> ayudante.
///
/// `en_proceso` existe para que el reclamo sea atomico: el poller del ayudante
/// hace un `updateMany` que solo mueve filas en `pendiente`, igual que
/// `claimUpdate` en el poller de Telegram. Sin este estado intermedio, dos
/// pasadas del poller podrian reclamar la misma fila a la vez.
enum EstadoSolicitudAyudante {
  pendiente
  en_proceso
  hecho
  fallo
}

/// La cola del Ayudante (userbot), en un solo sentido: **el bot encola, el
/// ayudante sirve**. Nunca al reves.
///
/// Es la unica puerta de entrada al userbot desde el ciclo de updates. El
/// nucleo de `apps/bot` no llama a MTProto ni conoce que existe una cuenta de
/// usuario detras: escribe una fila aqui y sigue. Si el ayudante esta caido,
/// con `FLOOD_WAIT` o sin sesion, la fila se queda `pendiente` y el ciclo de
/// updates ni se entera — la misma propiedad que ya protege `TelegramPort` al
/// no aceptar un `token`, aplicada aqui a un proceso entero.
///
/// `tipo` es texto y no enum a proposito, igual que `especie` en `Pet`: el
/// catalogo de tipos de solicitud crece por bloques (mencion real, ficha
/// completa, censo, aviso privado...) y un enum convertiria "un tipo nuevo" en
/// "una migracion nueva".
model AyudanteSolicitud {
  id       String @id @default(cuid())
  tenantId String

  /// Que se pide. Ver `apps/ayudante/src/despachador.ts` para el catalogo
  /// real de tipos que el ayudante sabe atender.
  tipo String

  /// Los datos de la solicitud. Forma libre porque cada `tipo` necesita algo
  /// distinto: un chatId y un userId no es lo mismo que un texto a enviar.
  payload Json

  estado EstadoSolicitudAyudante @default(pendiente)

  /// Cuantas veces se ha intentado. Sin tope aqui: cada tipo de solicitud
  /// decide su propio limite al leerlo, porque no es lo mismo reintentar un
  /// aviso privado que reintentar un censo completo.
  intentos Int @default(0)

  /// Lo que devolvio el ayudante al terminar. `null` mientras siga pendiente
  /// o en proceso.
  resultado Json?
  /// El motivo del fallo, si `estado` es `fallo`. Nunca se reintenta un fallo
  /// en silencio: queda escrito por que no se pudo.
  error String?

  creadaEn    DateTime  @default(now())
  reclamadaEn DateTime?
  resueltaEn  DateTime?

  /// El reclamo del poller es un `updateMany` sobre filas `pendiente`
  /// ordenadas por `creadaEn`: sin este indice seria un escaneo completo en
  /// cada pasada.
  @@index([estado, creadaEn])
  @@map("ayudante_solicitudes")
}

/// Una foto del grupo tal y como lo ve el ayudante, no el bot.
///
/// El bot solo conoce a quien le ha escrito desde que entro; el userbot puede
/// listar miembros de verdad (`channels.getParticipants`), que es la unica
/// forma de ver a los fantasmas y a quien se fue sin mensaje de servicio. Cada
/// censo nuevo actualiza `vistoEn` de quien sigue y marca `presente = false`
/// en quien ya no aparece, sin borrar la fila: la salida silenciosa es un dato,
/// no un olvido.
model AyudanteCensoMiembro {
  id             String @id @default(cuid())
  tenantId       String
  chatId         String
  userTelegramId BigInt

  alias  String?
  nombre String?

  /// Si el ultimo censo lo encontro todavia dentro del grupo.
  presente Boolean @default(true)

  /// La ultima vez que un censo lo vio en la lista de miembros.
  vistoEn DateTime @default(now())
  /// La ultima vez que el userbot pudo ver su estado de conexion
  /// (`status.wasOnline`), si Telegram lo permite para esta cuenta. Es la base
  /// de "quien esta en linea ahora" y del mapa de husos horarios; no todo el
  /// mundo lo expone.
  ultimaConexionEn DateTime?

  creadaEn DateTime @default(now())

  @@unique([tenantId, chatId, userTelegramId])
  @@index([tenantId, chatId, presente])
  @@map("ayudante_censo_miembros")
}

/// El historial de alias de alguien, dentro de un grupo.
///
/// Existe porque el bot solo ve un cambio de alias si la persona escribe
/// despues de cambiarselo; el censo del ayudante lo ve aunque se quede callada,
/// que es justo el caso de quien se cambia el nombre para escaquearse de una
/// sancion.
model AyudanteAliasHistorial {
  id             String @id @default(cuid())
  tenantId       String
  chatId         String
  userTelegramId BigInt

  alias        String?
  detectadoEn  DateTime @default(now())

  @@index([tenantId, chatId, userTelegramId])
  @@map("ayudante_alias_historial")
}

/// Un evento del registro de administracion nativo de Telegram
/// (`channels.getAdminLog`), que la Bot API no expone en absoluto.
///
/// `telegramEventId` es el id que trae el propio evento de Telegram, y es la
/// clave de idempotencia: sincronizar el mismo tramo de log dos veces no debe
/// duplicar filas.
///
/// Quien lee esto importa tanto como lo que dice: la vista para el staff
/// oculta `actorTelegramId` (ver `apps/ayudante/src/bloques/moderacion.ts`,
/// `vistaStaff`), porque el registro de que moderador hizo que cosa es
/// auditoria del propio staff, y esa es solo del propietario — la misma razon
/// por la que `puedeModerar` y `puedeConfigurar` son preguntas distintas en
/// `PermisosPort`.
model AyudanteAdminLogEvento {
  id       String @id @default(cuid())
  tenantId String
  chatId   String

  telegramEventId String

  accion              String
  actorTelegramId     BigInt
  objetivoTelegramId  BigInt?
  detalle             Json?

  ocurrioEn    DateTime
  ingresadoEn  DateTime @default(now())

  @@unique([tenantId, chatId, telegramEventId])
  @@index([tenantId, chatId, ocurrioEn])
  @@map("ayudante_admin_log_eventos")
}

/// Cuanta gente ha traido cada enlace de invitacion, segun Telegram
/// (`messages.getExportedChatInvites` / `checkChatInvite`), no segun una
/// cuenta a ojo.
model AyudanteEnlaceInvitacion {
  id       String @id @default(cuid())
  tenantId String
  chatId   String

  /// El enlace en si (o su slug), tal y como lo devuelve Telegram.
  enlaceId String

  creadorTelegramId BigInt
  /// Usos acumulados de por vida, tal y como los cuenta Telegram. Se
  /// SOBRESCRIBE en cada sincronizacion, nunca se suma: sumar dos lecturas del
  /// mismo contador lo duplicaria.
  usosTotal         Int    @default(0)
  /// Cuantos de esos usos ya se han pagado en comisiones.
  ///
  /// Sin esta columna la comision se calculaba sobre `usosTotal`, o sea sobre
  /// la vida entera del enlace, y cada ejecucion del ranking volvia a pagar
  /// todo lo ya pagado. Es la misma proteccion que el `refId` del libro mayor
  /// da al rendimiento de las mascotas, en el unico otro sitio donde este
  /// repo acuña moneda.
  usosLiquidados    Int    @default(0)

  sincronizadoEn DateTime @default(now())
  creadoEn       DateTime @default(now())

  @@unique([tenantId, chatId, enlaceId])
  @@index([tenantId, chatId, creadorTelegramId])
  @@map("ayudante_enlaces_invitacion")
}

/// Si un aviso por privado llego, y si se sabe por que no.
///
/// Es la pieza que arregla el problema escrito en el plan de mascotas: "mucha
/// gente tiene el bot bloqueado y un aviso que no llega convierte la factura
/// en una encerrona". Una cuenta de usuario puede escribir a alguien que nunca
/// le ha hablado al bot; esta tabla es la prueba de si lo consiguio.
enum EstadoAvisoPrivado {
  pendiente
  enviado
  rebotado
  bloqueado
}

model AyudanteAvisoPrivado {
  id                     String @id @default(cuid())
  tenantId               String
  destinatarioTelegramId BigInt

  /// Que tipo de aviso es: "sancion_expira", "verificacion_pendiente",
  /// "mascota_enferma"... Ver cada bloque para su catalogo.
  tipo String

  estado EstadoAvisoPrivado @default(pendiente)

  /// Los datos del aviso; no el texto final, que se compone al enviar.
  detalle Json?

  creadoEn  DateTime  @default(now())
  enviadoEn DateTime?

  @@index([tenantId, destinatarioTelegramId, tipo])
  @@map("ayudante_avisos_privados")
}

/// Un hash del avatar de alguien, en el momento en que el ayudante lo vio.
///
/// Sirve para dos cosas con la misma tabla: el historial de avatares de una
/// persona (varias filas con el mismo `telegramId`), y la deteccion de
/// multicuenta (dos `telegramId` distintos con el mismo `hash`). No se guarda
/// la foto, solo su huella.
model AyudanteAvatarHash {
  id         String @id @default(cuid())
  telegramId BigInt
  hash       String

  detectadoEn DateTime @default(now())

  @@unique([telegramId, hash])
  /// Buscar coincidencias de hash entre distintas cuentas es la consulta
  /// entera de la deteccion de multicuenta.
  @@index([hash])
  @@map("ayudante_avatar_hashes")
}

/// Una medicion del watchdog: el ayudante hace ping al bot desde fuera de su
/// propio proceso, con una cuenta de usuario, y mide cuanto tarda en
/// contestar. Es la unica metrica de salud que no depende del propio bot para
/// existir.
model AyudanteWatchdogMedicion {
  id         String   @id @default(cuid())
  medidoEn   DateTime @default(now())
  latenciaMs Int?
  ok         Boolean

  @@index([medidoEn])
  @@map("ayudante_watchdog_mediciones")
}
