// --- Guardian Verification: per-chat config + join-request verification flow ---

/// Mini App opens we can attribute to a person OUTSIDE the verification flow —
/// mainly the games app. Recorded so the multi-account check also sees members
/// who play but never (re)verified, which is most of them.
///
/// One row per (bot, person, IP): a repeat open from the same address bumps the
/// counter instead of adding a row, so the table tracks distinct connections
/// rather than growing with every app launch. Scoped by botUsername, which is
/// what keeps a managed child bot's visitors out of another bot's roster.
///
/// Kept indefinitely, by the owner's explicit decision, and disclosed in the
/// group description. The lastSeenAt index exists anyway so a retention sweep
/// stays cheap if that decision ever changes.
model MiniappVisit {
  id             String   @id @default(cuid())
  botUsername    String
  telegramUserId BigInt
  username       String?
  firstName      String?
  lastName       String?
  ip             String
  countryCode    String?
  /// Raw Telegram id of the group the Mini App was opened FOR, when the deep
  /// link carried one. Null when it did not (the portable games hub).
  ///
  /// This is what keeps one community's roster from showing another's members:
  /// a single bot serves many groups, so scoping visits by bot alone would put
  /// the IP of someone from an unrelated group in front of these admins.
  groupTelegramId BigInt?
  /// Which Mini App the person opened, e.g. "games".
  surface        String
  visits         Int      @default(1)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@unique([botUsername, telegramUserId, ip])
  @@index([botUsername, ip])
  @@index([groupTelegramId])
  @@index([lastSeenAt])
  @@map("miniapp_visits")
}

model GuardianVerificationSettings {
  id            String       @id @default(cuid())
  tenantId      String
  chatId        String       @unique
  enabled       Boolean      @default(false)
  mode          GuardianMode @default(off)
  // Raw Telegram chat id of the STAFF chat/channel (not necessarily a chat we
  // track in `Chat` — often a private staff-only channel the bot posts to).
  staffChatId   BigInt?
  staffThreadId Int?
  /// Additional STAFF rooms the report is mirrored to, as
  /// `[{ "chatId": "-100...", "threadId": 6 }]` (chatId a STRING: these are
  /// larger than a JS number survives). The primary staffChatId above stays the
  /// first destination; this is purely extra reach.
  ///
  /// JSON rather than a table because it is a short, whole-value list edited as
  /// one field in the Mini App — the same reasoning as allowedCountries. What
  /// DOES get a table is where each copy actually landed
  /// (VerificationStaffReport), because those rows are written per send and read
  /// back one by one by retention.
  extraStaffChats Json?
  // When true, STAFF report photos are kept in the chat forever (the send path
  // stamps no retention deadline, so the cleanup job never deletes them).
  keepStaffPhotos Boolean @default(false)
  /// Decline the join request of someone whose verification simply ran out —
  /// they opened it and never finished, or never opened it at all.
  ///
  /// Separate from allowAutomaticDecline on purpose. That one acts on a
  /// JUDGEMENT ("the AI thinks this person fails"), where a false positive
  /// throws out a real member. This one acts on the absence of any judgement at
  /// all, so it cannot be wrong about a person — and declining is not banning:
  /// it frees them to request again, which is exactly what Telegram forbids
  /// while a request sits pending. Wanting one without the other is normal.
  declineOnExpiry Boolean @default(false)

  captureMode         GuardianCaptureMode         @default(video_with_fallback)
  challengeDifficulty GuardianChallengeDifficulty @default(normal)
  // Array of enabled challenge kinds (face/hands/sequences); null = defaults.
  enabledChallenges   Json?

  maxAttempts         Int @default(3)
  sessionTtlSeconds   Int @default(600)
  mediaRetentionHours Int @default(72)

  autoApproveThreshold  Float @default(0.85)
  manualReviewThreshold Float @default(0.55)
  livenessMinimum       Float @default(0.6)
  gestureMinimum        Float @default(0.6)
  replayRiskMaximum     Float @default(0.4)
  syntheticRiskMaximum  Float @default(0.4)

  requireSingleFace Boolean @default(true)
  estimateAge       Boolean @default(false)
  minimumAge        Int?
  maximumAge        Int?
  // 1 = single photo (default). 2 = double verification: a second photo with
  // a DIFFERENT requested gesture, cross-checked by AI to confirm it's the
  // same person as the first — never silently skipped when requested (see
  // decision-engine.ts's samePersonStatus gate).
  requiredPhotos Int @default(1)

  // ISO 3166-1 alpha-2 codes (e.g. ["ES","PT"]). Empty = no restriction.
  // Resolved from the person's IP (via Cloudflare's CF-IPCountry header —
  // never phone number or GPS location) captured silently on the Mini App's
  // first request, before any consent/photo UI — see decision-engine.ts's
  // countryCode gate and GuardianVerifyController.getSession.
  allowedCountries String[] @default([])

  allowAutomaticDecline    Boolean @default(false)
  sendApprovedCasesToStaff Boolean @default(true)
  protectStaffContent      Boolean @default(true)
  locale                   String  @default("es")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("guardian_verification_settings")
}

// One row per Telegram `chat_join_request`. Lifecycle: pending -> miniapp_opened
// -> capturing -> analyzing -> (resolved | awaiting_retry -> capturing again) ->
// expired/cancelled. `chatId`/`telegramUserId` etc. are plain indexed columns
// (no Prisma relation), matching the CaptchaConfig/CaptchaSession convention
// used elsewhere in this schema.
model VerificationSession {
  id             String @id @default(cuid())
  tenantId       String
  chatId         String
  telegramChatId BigInt
  telegramUserId BigInt
  // Private chat id with the user, when known (e.g. to DM a result). Distinct
  // from telegramUserId because a user id is not always usable as a chat id
  // for bots that never received a /start in DM.
  userChatId     BigInt?

  // AES-256-GCM ciphertext (iv+tag packed, base64) of the Bot API
  // chat_join_request query_id. Only needed to answer the FIRST
  // answerChatJoinRequestQuery call; nulled out once that call succeeds. Manual
  // staff decisions after an initial `queue` answer use the already-implemented
  // approveChatJoinRequest/declineChatJoinRequest (chat_id + user_id) instead —
  // see docs/GUARDIAN_TELEGRAM_TEST.md for why.
  joinRequestQueryIdEncrypted String?

  username        String?
  firstName       String?
  lastName        String?
  languageCode    String?
  inviteLinkName  String?
  // ISO 3166-1 alpha-2, resolved from the person's IP (Cloudflare's
  // CF-IPCountry) on the Mini App's very first request and pinned here —
  // never re-derived later, so enabling a VPN mid-flow can't change it.
  countryCode     String?
  // Client IP (Cloudflare cf-connecting-ip) captured on that same first
  // request and pinned. Shown to STAFF for fraud/multi-account signals.
  verifierIp      String?

  status           GuardianSessionStatus @default(pending)
  decision         GuardianDecision?
  decisionReason   String?
  // Structured explanation: decision codes, signals, thresholds, policy
  // version — never just a free-text summary, so STAFF can audit the "why".
  decisionPayload  Json?
  // Snapshot of the chat's GuardianMode at session creation, so a later config
  // change can't reinterpret an in-flight session under a different policy.
  mode             GuardianMode

  challengeDefinition Json
  // Single-use nonce embedded in the challenge; a replayed/edited client
  // submission that doesn't match is rejected.
  challengeNonce      String @unique
  // SHA-256 hash of the opaque bearer token handed to the Mini App URL. The
  // raw token is never persisted.
  sessionTokenHash    String @unique

  expiresAt    DateTime
  attemptCount Int      @default(0)
  /// Furthest screen the person reached in the Mini App, as a rank:
  /// 0 never opened it · 1 opened · 2 accepted consent · 3 declared age
  /// 4 camera granted · 5 photo submitted.
  ///
  /// Telemetry, not state — it only ever moves FORWARD (see advanceProgress),
  /// so a page reload cannot walk it back. Exists because "they abandoned" was
  /// all we could see: over half of the people who opened the app never
  /// reached the photo, and nothing recorded WHICH screen lost them.
  progressStep Int      @default(0)
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  resolvedAt   DateTime?

  staffChatId            BigInt?
  staffMessageId         Int?
  staffReportMessageId   Int?
  // When the STAFF report message becomes eligible for retention deletion.
  // Stamped at send time so the cleanup worker is driven by the session (photo
  // and no-media text reports alike), never by the mutable media delete cursor.
  staffReportDeleteAfter DateTime?

  // Optimistic lock: every state transition (session update, staff decision,
  // Telegram answer) increments this and checks it in the WHERE clause so two
  // concurrent resolutions (e.g. auto-decision race with a staff tap) can't
  // both "win".
  version Int @default(1)

  // Deterministic hash of (chatId, telegramUserId) while a session is ACTIVE;
  // set back to null on resolution/expiry so a later join request can start a
  // fresh session. The @unique constraint is what actually prevents a second
  // concurrent session for the same person in the same chat (Postgres allows
  // unlimited NULLs in a unique column, so resolved sessions don't collide).
  idempotencyKey String? @unique

  /// Every room this session's STAFF report was delivered to.
  staffReports VerificationStaffReport[]

  @@index([tenantId, chatId, status])
  @@index([tenantId, telegramUserId])
  @@index([expiresAt])
  @@index([staffReportDeleteAfter])
  @@map("verification_sessions")
}

/// One delivered copy of a STAFF report.
///
/// Exists because a report can now land in several rooms, and every copy has to
/// be findable again: retention must delete each one, and a verdict has to be
/// stamped on all of them, not just the message whose button was pressed.
/// Before this the session carried a single (staffChatId, staffReportMessageId)
/// pair, which cannot describe more than one destination.
model VerificationStaffReport {
  id             String   @id @default(cuid())
  sessionId      String
  telegramChatId BigInt
  messageId      Int
  threadId       Int?
  /// The copy that owns the canonical route. Not about permissions — every copy
  /// carries the decision buttons and the session's optimistic lock decides who
  /// wins — but the primary is the one worth naming in logs and errors.
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  session VerificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, telegramChatId, messageId])
  @@index([sessionId])
  @@map("verification_staff_reports")
}

model VerificationAttempt {
  id            String   @id @default(cuid())
  sessionId     String
  attemptNumber Int
  captureType   String
