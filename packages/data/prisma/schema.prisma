// --- Casino chip economy (virtual, non-cashable) ---

model ChipWallet {
  id             String   @id @default(cuid())
  tenantId       String
  telegramUserId BigInt
  balance        Int      @default(0)
  // Provably-fair commit-reveal seed pair. serverSeed is SECRET until rotation;
  // serverSeedHash is the public commit shown before any bet. nonce increments
  // per bet so every outcome is reproducible from (serverSeed, clientSeed, nonce).
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, telegramUserId])
  @@index([tenantId])
  @@map("chip_wallets")
}

model ChipLedger {
  id             String   @id @default(cuid())
  tenantId       String
  telegramUserId BigInt
  delta          Int
  reason         String
  // refId links a row to its origin (betId, or a UTC day for the daily bonus).
  // The composite unique makes idempotent grants (daily/bonus) safe.
  refId          String?
  // chargeId is the Telegram Stars idempotency key (one credit per purchase).
  chargeId       String?  @unique
  createdAt      DateTime @default(now())

  @@unique([tenantId, telegramUserId, reason, refId])
  @@index([tenantId, telegramUserId])
  @@map("chip_ledger")
}

model CasinoDuel {
  id             String   @id @default(cuid())
  tenantId       String
  chatId         String
  challengerId   BigInt
  challengerName String?
  stake          Int
  status         String   @default("open") // open | rolling | settled | cancelled
  opponentId     BigInt?
  winnerId       BigInt?
  createdAt      DateTime @default(now())

  @@index([tenantId, status])
  @@map("casino_duels")
}

/// A live match between two real people (tres en raya, and whatever turn-based
/// game comes next). The SERVER owns the position: `state` is the board, and a
/// client only ever asks to move.
model GameMatch {
  id         String   @id @default(cuid())
  tenantId   String
  /// Where the invite was posted, so the lobby message can be edited when the
  /// seat is taken and when the match ends.
  chatId     BigInt
  /// Set once the invite message exists; null if posting it failed, which must
  /// not stop the match itself from being playable via its link.
  messageId  Int?
  game       String
  hostId     BigInt
  hostName   String?
  /// Null until somebody takes the seat — which is exactly what "open" means.
  guestId    BigInt?
  guestName  String?
  status     String   @default("open") // open | playing | finished | cancelled
  /// Board position, owned by the server. JSON so a second game can store its
  /// own shape without a migration.
  state      Json
  /// host | guest | draw, only once status is finished.
  result     String?
  /// Optimistic lock, same idiom as VerificationSession. Two taps that both
  /// pass the turn check would otherwise each write a board, and the loser
  /// would vanish with no sign that a move was dropped.
  version    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Empty for the two-seat games, which keep using hostId/guestId above. Only
  /// the group games (impostor, colour cards, group wordle) fill this in.
  players GameMatchPlayer[]

  /// The lobby lists open matches per chat; the sweeper scans by status+age.
  @@index([tenantId, chatId, status])
  @@index([status, updatedAt])
  @@map("game_matches")
}

/// A seat at a group match, for the games that seat more than two people.
///
/// A row per player instead of a list inside `GameMatch.state` for two reasons,
/// and both are the kind that only show up in production:
///
/// 1. Joining is a race. Six people tapping "me apunto" at the same moment all
///    read the same roster and all write their own version of it back; five of
///    them vanish with nothing to show it happened. A unique index on
///    (matchId, userId) makes the database settle it instead.
/// 2. `secret` must be hard to leak. Anything that lives inside the match state
///    rides along in every response that returns the match, so one careless
///    endpoint shows the whole table the impostor's word or somebody's hand.
///    Kept here, leaking it takes an explicit join that somebody has to write.
model GameMatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  tenantId String
  userId   BigInt
  name     String?

  /// Order of arrival; 0 is whoever opened the match. Turn order is derived
  /// from this, so there is no separate "whose turn" field that could end up
  /// pointing at somebody who already left.
  seatIndex Int

  /// alive | out | left. Nobody is deleted: a match has to be able to say who
  /// was eliminated and when, and a vote cast by someone since removed still
  /// has to count for the round it belonged to.
  status String @default("alive")

  /// What only this person may see — the impostor's word, a hand of cards.
  /// Null for games where nothing is private.
  secret Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  /// One seat per person, and one person per seat.
  @@unique([matchId, userId])
  @@unique([matchId, seatIndex])
  /// "What am I playing right now" across chats.
  @@index([tenantId, userId])
  @@map("game_match_players")
}

/// One day's pole competition for one scope.
///
/// Derived from (timezone, reset time, now) at claim time rather than opened by
/// a job: a container that was down at midnight must still produce the right
/// window. `startsAt` is therefore the identity of the window, not merely a
/// timestamp — two processes computing it from the same inputs get the same
/// instant, which is what makes the unique index below meaningful.
model PoleWindow {
  id           String   @id @default(cuid())
  tenantId     String
  chatId       BigInt
  /// Null when the group runs one competition for the whole chat, which is the
  /// default. Only set when the group asked to split by forum topic.
  threadId     Int?
  windowType   String   @default("daily")
  startsAt     DateTime
  endsAt       DateTime
  /// Stored alongside so a later timezone change cannot retroactively rewrite
  /// which day an old claim belonged to.
  timezone     String
  resetMinutes Int      @default(0)
  /// Local calendar day the window opened, "YYYY-MM-DD". Denormalised so
  /// monthly and yearly rankings are a prefix scan instead of a timezone
  /// conversion per row.
  dayKey       String
  createdAt    DateTime @default(now())

  claims PoleClaim[]

  /// Postgres does not treat two NULLs as equal, so this constraint does NOT
  /// cover the (majority) rows where threadId is null. The migration adds a
  /// partial unique index for that case — see POLE_SPEC §4.
  @@unique([tenantId, chatId, threadId, windowType, startsAt])
  @@index([tenantId, chatId, dayKey])
  @@map("pole_windows")
}

/// One awarded position inside a window.
///
/// The two unique indexes ARE the concurrency design. A claim is an INSERT, not
/// a read-then-write: whoever the database accepts holds the place, and a
/// rejection is information (that position is taken / you already have one)
/// rather than an error.
///
/// Deliberately absent: the text of the winning message. The report is explicit
/// that ids, a timestamp and the latency are enough (§5.9, §16.4).
model PoleClaim {
  id        String   @id @default(cuid())
  windowId  String
  /// 1 = pole, 2 = subpole, 3 = bronze, …
  position  Int
  userId    BigInt
  userName  String?
  messageId Int?
  /// Milliseconds from the window opening. Measures the ritual, not the person.
  latencyMs Int
  claimedAt DateTime @default(now())

  window PoleWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  /// Sin @@index([windowId]) a propósito: Postgres usa cualquier prefijo de un
  /// índice compuesto, así que los dos únicos de arriba ya cubren "las
  /// reclamaciones de esta ventana". Uno suelto costaba 14 MB por cada 654.000
  /// filas y se mantenía en cada INSERT sin ganar nada — medido, no supuesto.
  @@unique([windowId, position])
  @@unique([windowId, userId])
  @@map("pole_claims")
}

/// One spin of the virtual roulette.
///
/// Audit, cooldown source and idempotency key in one row. `messageId` rather
/// than `updateId` on purpose: a redelivered update carries the same message,
/// so the unique index below is what stops one command silencing somebody
/// twice.
///
/// The draw itself is never stored — publishing it would let anyone work out
/// when the next round is safe (report §6.8).
model RouletteRound {
  id          String   @id @default(cuid())
  tenantId    String
  chatId      BigInt
  threadId    Int?
  userId      BigInt
  messageId   Int
  numerator   Int
  denominator Int
  /// safe | adverse
  outcome     String
  /// fun | muted | degraded
  consequence String
  muteSeconds Int?
  /// Why an adverse round did nothing: no-permission | protected. Null
  /// otherwise. Kept so "the roulette is broken" reports can be answered.
  degradedWhy String?
  rngVersion  Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([tenantId, chatId, messageId])
  @@index([tenantId, chatId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("roulette_rounds")
}

/// A curated cat or dog.
///
/// `source` and `licence` are NOT NULL because an asset without recorded
/// provenance must be impossible to store, not merely discouraged (report
/// §8.2). Nothing in the codebase writes this table from a user-supplied URL.
model FunMediaAsset {
  id           String   @id @default(cuid())
  /// Null = available to every tenant; set = private to one bot's library.
  tenantId     String?
  /// cat | dog
  kind         String
  source       String
  licence      String
  attribution  String?
  /// Bytes, when the library holds the file itself. Null when the asset only
  /// ever existed as a Telegram file_id.
  storageKey   String?
  /// sha256 of the bytes, so the same picture cannot be added twice.
  contentHash  String?
  /// approved | pending | rejected. Only `approved` is ever served.
  safetyStatus String   @default("pending")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  telegramFiles TelegramMediaFile[]

  @@unique([kind, contentHash])
  @@index([kind, safetyStatus, active])
  @@map("fun_media_assets")
}

/// A Telegram file_id for one asset, for ONE bot.
///
/// Separate from the asset because a file_id is bound to the bot identity that
/// uploaded it: a child bot cannot send the parent's file_id. Re-uploading per
/// bot once and caching the result is the whole point (report §7.6, §12.7).
model TelegramMediaFile {
  id                  String   @id @default(cuid())
  assetId             String
  /// The bot this file_id belongs to. Same identity as everywhere else.
  tenantId            String
  /// Null mientras la subida no ha salido bien: la fila existe desde que se
  /// planifica el trabajo, no desde que termina.
  telegramFileId      String?
  telegramFileUniqueId String?
  /// pending | ready | failed | disabled. Solo `ready` se sirve.
  state               String   @default("pending")
  /// Intentos consumidos. Un 429 no da el recurso por perdido a la primera.
  attempts            Int      @default(0)
  /// Último error de Telegram, para que `failed` sea diagnosticable. Nunca
  /// lleva el token: el gateway construye el mensaje con método y estado.
  lastError           String?
  createdAt           DateTime @default(now())
  lastVerifiedAt      DateTime?

  asset FunMediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, tenantId])
  /// El job de preparación busca "lo que le falta a este bot".
  @@index([tenantId, state])
  @@map("telegram_media_files")
}

model CasinoBet {
  id             String   @id @default(cuid())
  tenantId       String
  telegramUserId BigInt
  game           String // crash | mines | blackjack
